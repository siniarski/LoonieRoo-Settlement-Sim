<Project Sdk="Godot.NET.Sdk/4.6.1">
  <!-- The Godot game: drawing and input. The sim is cs/Sim (pure C#, no Godot), referenced as it is. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>LoonieRoo.Game</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\cs\Sim\Sim.csproj" />
  </ItemGroup>
</Project>
