; LoonieRoo in Godot: the C# sim (cs/Sim) drawn and played. See godot/README.md.
config_version=5

[application]

config/name="LoonieRoo"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "C#")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="disabled"

[dotnet]

project/assembly_name="LoonieRoo"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

limits/global_shader_variables/buffer_size=131072

environment/defaults/default_clear_color=Color(0.05, 0.06, 0.055, 1)
