<Project Sdk="Microsoft.NET.Sdk">
  <!-- The game's simulation: pure C#, no Godot, so it builds, tests and runs anywhere. Deterministic: the same seed
       and commands give the same state. Ported from a TypeScript sim (retired: git tag ts-final), so it keeps
       JavaScript's number semantics (JsCompat.cs: see CLAUDE.md). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LoonieRoo.Sim</RootNamespace>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Ported code: nullable annotations outside a nullable context, and JS null checks on values C# knows are never null. -->
    <NoWarn>$(NoWarn);CS8669;CS0472</NoWarn>
  </PropertyGroup>
</Project>
